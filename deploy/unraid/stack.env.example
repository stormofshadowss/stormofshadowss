# StormOfShadowss — settings for the stand-alone Unraid stack (deploy/unraid/docker-compose.yml).
# Paste this into the stack's env box and fill in the first section. Never commit the real one — it holds passwords.

# ───── 1. Fill these in ─────

# Where the app's code comes from: your GitHub repository, then #main (the branch).
#   Public repository:   https://github.com/YOUR_USERNAME/stormofshadowss.git#main
#   Private repository:  https://YOUR_TOKEN@github.com/YOUR_USERNAME/stormofshadowss.git#main    (a read-only token; see SETUP.md)
REPO_URL=https://github.com/YOUR_USERNAME/stormofshadowss.git#main

# The database password (the app and backups use it). Pick a long random value, e.g. run:  openssl rand -base64 24
DB_PASSWORD=change-me-to-a-long-random-value

# The address people will type in a browser. Use your Unraid machine's address and the port below.
# Sign-in links and "claim your orders" links in emails are built from it.
PUBLIC_URL=http://192.168.1.50:2999

# Your GOM login, created automatically the FIRST time it starts (only if there is no admin yet).
# CHANGE the password: at least 12 characters, and not containing the username. (Left as CHANGE-ME, no admin is created and the app log says why.)
# After you have signed in once you can delete the password line.
INITIAL_ADMIN_USERNAME=gom
INITIAL_ADMIN_PASSWORD=CHANGE-ME
# Optional: an email for that admin account (never used to sign in). Leave blank unless you want one on record.
INITIAL_ADMIN_EMAIL=

# ───── 2. Fine as they are ─────

# Where the database, pictures and backups are kept on Unraid (it creates the folders).
DATA_DIR=/mnt/user/appdata/sos

# The app listens on port 2999 inside its container. APP_BIND is which address it's published on: 0.0.0.0 = reachable from any device on your network.
# (Use 127.0.0.1 to make it reachable from the Unraid machine only, e.g. when you use the Cloudflare tunnel.)
APP_BIND=0.0.0.0
APP_PORT=2999

# Plain http on your home network needs "false"; if you serve it over https (e.g. the Cloudflare tunnel), set true — and set TRUST_PROXY=1.
COOKIE_SECURE=false
TRUST_PROXY=0

# ───── 3. Optional ─────

# Email (for sign-in links). Leave SMTP_HOST blank while testing: the links are then printed in the sos-app container's log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StormOfShadowss <orders@yourdomain.com>

# Backups (the database and pictures, into DATA_DIR/backups).
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=24

# Optional extras — list the ones you want, comma separated:  tunnel  (Cloudflare, needs the token below)   tools  (a database viewer on port 8081, this machine only)
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Shown on the privacy notice (/privacy.html) as where people can send questions or requests about their personal information. Optional, but worth setting.
CONTACT_EMAIL=

# Other settings (you won't normally change these).
DB_NAME=sos
DB_USER=sos
ADMIN_SESSION_HOURS=12
REMINDERS_ENABLED=true
REMINDER_EVERY_MINUTES=60
INVITE_DAYS=7
