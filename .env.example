# Copy this file to ".env" and fill it in. Never commit the real .env.

# ───── Database ─────
# Pick long random values (e.g. `openssl rand -base64 24`).
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app
DB_NAME=sos
DB_USER=sos
# Using a MariaDB you already run on Unraid instead of the bundled one? Set its address here
# (leave commented out otherwise) and see the README, "Using your existing MariaDB".
# DB_HOST=192.168.1.50
# DB_PORT=3306

# ───── The website ─────
# The address people type in their browser. Sign-in links in emails are built from it.
#   Public site through a Cloudflare Tunnel:  https://orders.yourdomain.com
#   Quick test on your home network only:     http://192.168.1.50:3000   (and set COOKIE_SECURE=false below)
PUBLIC_URL=https://orders.example.com

# The GOM login (username + password) is NOT set here. You create it once with a command after the
# site is running — see SETUP.md, Stage 2. The password is stored hashed in the database, never in a file.
# How many hours an admin stays signed in before having to sign in again:
ADMIN_SESSION_HOURS=12

# true when the site is served over HTTPS (the normal case).
# Set false ONLY for plain-http testing on your home network, otherwise browsers refuse to keep the login.
COOKIE_SECURE=true

# Where the app listens on the Unraid host. 127.0.0.1 = only that machine (use this with the tunnel).
# Use 0.0.0.0 to reach it from other devices on your home network while testing.
APP_BIND=127.0.0.1
APP_PORT=3000

# ───── Email (for the sign-in links) ─────
# Leave SMTP_HOST blank while testing: links are then printed in the app container's log instead.
# For real use, any SMTP provider works (Brevo, Resend, Mailgun, a Gmail app password, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StormOfShadowss <orders@yourdomain.com>

# ───── Backups ─────
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=24

# ───── Cloudflare Tunnel (optional; only with:  docker compose --profile tunnel up -d) ─────
CLOUDFLARE_TUNNEL_TOKEN=

# Where the database files and backups live on the host. On Unraid, keep this under /mnt/user/appdata.
DATA_DIR=./data

# Overdue-payment reminder emails (sent once per overdue claim, and only to people who turned on email notifications).
REMINDERS_ENABLED=true
REMINDER_EVERY_MINUTES=60

# Pictures are stored under DATA_DIR/uploads (see SETUP.md — the folder must be writable by user 1000).

# How many days a "claim your orders" link works for (People tab).
INVITE_DAYS=7
